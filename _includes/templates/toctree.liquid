{%- include common/rest/workdir.liquid %}

{% comment %} list the root files (use first H1 if present) {% endcomment %}
<ul>
    {%- for item in workdir_files -%}
        {%- assign md_content = item.content | split: "\n" -%}
        {%- assign heading = "" -%}
        {%- for line in md_content -%}
            {%- if line | slice: 0, 2 == "# " -%}
                {%- assign heading = line | slice: 2, line.size | strip -%}
                {%- break -%}
            {%- elsif line contains "<h1" -%}
                {%- assign heading = line | strip_html | strip -%}
                {%- break -%}
            {%- endif -%}
        {%- endfor -%}
        {%- if heading == "" -%}
            {%- for line in md_content -%}
                {%- if line | slice: 0, 3 == "## " -%}
                    {%- assign heading = line | slice: 3, line.size | strip -%}
                    {%- break -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}
        {%- assign display_title = heading | default: item.title | default: item.name -%}
        {%- assign level = item.dir | append: "temp" | replace_first: "/", "" | split: "/" | size -%}
        {%- capture current -%}
            {%- if page.url == item.url %}current{% endif -%}
        {%- endcapture %}
        <li class="toc level-{{ level }} {{ current }}" data-sort="{{ item.sort }}" data-level="{{ level }}">
            <a class="d-flex flex-items-baseline {{ current }}" href="{{ item.url | relative_url }}">
                {{ display_title }}
            </a>
        </li>
    {%- endfor %}
</ul>

{% comment %} list the root dirs {% endcomment %}
{%- for workdir in workdir_dirs %}{% include templates/_toctree.liquid %}{% endfor -%}