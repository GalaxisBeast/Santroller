{%- include common/rest/workdir.liquid %}

{% comment %} Debug: show workdir variables for troubleshooting {% endcomment %}
<details class="toc-debug">
  <summary>Debug: workdir variables</summary>
  <div>
    <p><strong>workdir_dirs (count):</strong> {{ workdir_dirs | size }}</p>
    <ul>
      {%- for d in workdir_dirs -%}
        <li>{{ d }}</li>
      {%- endfor -%}
    </ul>
    <p><strong>workdir_files (count):</strong> {{ workdir_files | size }}</p>
    <ol>
      {%- for f in workdir_files limit:8 -%}
        <li><code>{{ f.url }}</code> — {{ f.title | default: f.name }}</li>
      {%- endfor -%}
    </ol>
  </div>
</details>

{% comment %} list the root files {% endcomment %}
<ul>
    {%- for item in workdir_files -%}
        {%- assign level = item.dir | append: "temp" | replace_first: "/", "" | split: "/" | size -%}
        {%- capture current -%}
            {%- if page.url == item.url %}current{% endif -%}
        {%- endcapture %}
        <li class="toc level-{{ level }} {{ current }}" data-sort="{{ item.sort }}" data-level="{{ level }}">
            <a class="d-flex flex-items-baseline {{ current }}" href="{{ item.url | relative_url }}">
                {{ item.title | default: item.name }}
            </a>
        </li>
    {%- endfor %}
</ul>

{% comment %} list the root dirs {% endcomment %}
{%- for workdir in workdir_dirs %}{% include templates/_toctree.liquid %}{% endfor -%}