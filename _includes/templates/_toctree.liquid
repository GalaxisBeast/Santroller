{%- include common/rest/workdir.liquid %}

<ul class="toc-root">

    {%- comment %} Directories: category dropdowns (computed from workdir_files) {% endcomment %}
    {%- assign _dirs_str = "" -%}
    {%- for f in workdir_files -%}
        {%- if f.dir != "" -%}
            {%- unless _dirs_str contains f.dir -%}
                {%- assign _dirs_str = _dirs_str | append: f.dir | append: "||" -%}
            {%- endunless -%}
        {%- endif -%}
    {%- endfor -%}
    {%- assign subdirs = _dirs_str | split: "||" -%}
    {%- for subdir in subdirs -%}
        {%- if subdir == "" -%}
            {%- continue -%}
        {%- endif -%}
        {%- assign folder_active = false -%}
        {%- for item in workdir_files -%}
            {%- if item.url contains subdir and page.url == item.url -%}
                {%- assign folder_active = true -%}
                {%- break -%}
            {%- endif -%}
        {%- endfor -%}
        <li class="toc-category">
            <details class="folder-details"{% if folder_active %} open{% endif %}>
                <summary class="folder-toggle" role="button" aria-expanded="{% if folder_active %}true{% else %}false{% endif %}">
                    {{ subdir | split: "/" | last }}
                </summary>
                <ul class="dropdown">
                {%- assign workdir = subdir -%}
                {%- for item in workdir_files -%}
                    {%- if item.url contains subdir -%}
                        {%- assign md_content = item.content | split: "\n" -%}
                        {%- assign heading = "" -%}
                        {%- for line in md_content -%}
                            {%- if line | slice: 0, 2 == "# " -%}
                                {%- assign heading = line | slice: 2, line.size | strip -%}
                                {%- break -%}
                            {%- elsif line contains "<h1" -%}
                                {%- assign heading = line | strip_html | strip -%}
                                {%- break -%}
                            {%- endif -%}
                        {%- endfor -%}
                        {%- if heading == "" -%}
                            {%- for line in md_content -%}
                                {%- if line | slice: 0, 3 == "## " -%}
                                    {%- assign heading = line | slice: 3, line.size | strip -%}
                                    {%- break -%}
                                {%- endif -%}
                            {%- endfor -%}
                        {%- endif -%}

                        {%- capture current -%}{%- if page.url == item.url %}current{% endif -%}{%- endcapture -%}

                        <li class="toc-file {{ current }}">
                            <a href="{{ item.url | relative_url }}" class="{{ current }}">
                                {{ heading | default: item.name }}
                            </a>
                        </li>
                    {%- endif -%}
                {%- endfor -%}
                </ul>
            </details>
        </li>
    {%- endfor -%}

</ul>

<style>
.toc-category .dropdown { display: none; margin-left: 1em; }
.folder-details[open] > .dropdown { display: block; }
.folder-toggle { background: none; border: none; font-weight: bold; cursor: pointer; padding: 0.25em 0; width: 100%; text-align: left; }
.folder-details > summary { list-style: none; }
.folder-details > summary::-webkit-details-marker { display: none; }
.toc-file a.current { font-weight: bold; }
</style>