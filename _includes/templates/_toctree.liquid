{%- include common/rest/workdir.liquid %}

<ul class="toc-root">

    {%- comment %} Directories: category dropdowns {% endcomment %}
    {%- for subdir in workdir_dirs -%}
        {%- assign folder_active = false -%}
        {%- for item in workdir_files -%}
            {%- if item.url contains subdir and page.url == item.url -%}
                {%- assign folder_active = true -%}
                {%- break -%}
            {%- endif -%}
        {%- endfor -%}
        <li class="toc-category">
            <button class="folder-toggle{% if folder_active %} active{% endif %}" type="button" aria-expanded="{% if folder_active %}true{% else %}false{% endif %}">
                {{ subdir | split: "/" | last }}
            </button>
            <ul class="dropdown">
                {%- assign workdir = subdir -%}
                {%- for item in workdir_files -%}
                    {%- if item.url contains subdir -%}
                        {%- assign md_content = item.content | split: "\n" -%}
                        {%- assign heading = "" -%}
                        {%- for line in md_content -%}
                            {%- if line | slice: 0, 2 == "# " -%}
                                {%- assign heading = line | slice: 2, line.size | strip -%}
                                {%- break -%}
                            {%- endif -%}
                        {%- endfor -%}

                        {%- capture current -%}{%- if page.url == item.url %}current{% endif -%}{%- endcapture -%}

                        <li class="toc-file {{ current }}">
                            <a href="{{ item.url | relative_url }}" class="{{ current }}">
                                {{ heading | default: item.name }}
                            </a>
                        </li>
                    {%- endif -%}
                {%- endfor -%}
            </ul>
        </li>
    {%- endfor -%}

</ul>

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll('.folder-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
            btn.classList.toggle('active');
        });
    });
});
</script>

<style>
.toc-category > .dropdown { display: none; margin-left: 1em; }
.folder-toggle.active + .dropdown { display: block; }
.folder-toggle { background: none; border: none; font-weight: bold; cursor: pointer; padding: 0.25em 0; width: 100%; text-align: left; }
.toc-file a.current { font-weight: bold; }
</style>