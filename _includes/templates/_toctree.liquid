{%- include common/rest/workdir.liquid %}

{%- assign dir = site_pages | where: "url", workdir | first -%}

{%- if workdir_level == 2 %}
    <a class="caption d-block text-uppercase no-wrap px-2 py-0" href="{{ dir.url | relative_url }}">
        {{ dir.title | default: dir.url }}
    </a>
{%- else %}
    <a class="d-flex flex-items-baseline" href="{{ dir.url | relative_url }}">
        {{ dir.title | default: dir.url }}
    </a>
{%- endif -%}

<ul>
    {%- comment %} List files with first ### heading {% endcomment %}
    {%- for item in workdir_files -%}
        {%- assign md_content = item.content | split: "\n" -%}
        {%- assign heading = "" -%}
        {%- for line in md_content -%}
            {%- if line contains "### " -%}
                {%- assign heading = line | remove: "### " | strip -%}
                {%- break -%}
            {%- endif -%}
        {%- endfor -%}

        {%- assign level = item.dir | append: "temp" | replace_first: "/", "" | split: "/" | size | minus: 1 -%}
        {%- capture current -%}
            {%- if page.url == item.url %}current{% endif -%}
        {%- endcapture %}

        <li class="toc level-{{ level }} {{ current }}" data-sort="{{ item.sort }}" data-level="{{ level }}">
            <a class="d-flex flex-items-baseline {{ current }}" href="{{ item.url | relative_url }}">
                {{ heading | default: item.name }}
            </a>
        </li>
    {%- endfor -%}

    {%- comment %} List directories as dropdowns {% endcomment %}
    {%- for workdir in workdir_dirs -%}
        {%- assign level = workdir | append: "temp" | replace_first: "/", "" | split: "/" | size | minus: 2 -%}
        <li class="toc level-{{ level }}">
            <button class="folder-toggle">{{ workdir | split: "/" | last }}</button>
            <ul class="dropdown">
                {% include templates/_toctree.liquid %}
            </ul>
        </li>
    {%- endfor -%}
</ul>

<script>
document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('.folder-toggle').forEach(btn => {
        btn.addEventListener('click', () => btn.classList.toggle('active'));
    });
});
</script>

<style>
.dropdown { display: none; padding-left: 1em; }
.folder-toggle.active + .dropdown { display: block; }
.folder-toggle { background: none; border: none; cursor: pointer; text-align: left; width: 100%; padding: 0.2em 0; }
</style>